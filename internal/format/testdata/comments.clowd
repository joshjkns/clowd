# One.
# Two.
use aws
# Before a relate group.
api connects to db
db connects to api

# A new section inside the group.
api reads uploads
service api # on the header
  # first in the block
  image x
  # last in the block
# leading the next statement
on aws
  # only a comment before the setting
  network
    # inside a nested block
    vpc vpc-1
