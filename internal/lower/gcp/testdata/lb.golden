info: on gcp: web has no `send /` route, so paths no route matches go to admin
 --> lb.clowd:9:15
  |
9 | load balancer web
  |               ^^^

{
  "//": "Generated by clowd from lb.clowd. Edit that file instead: this one is rewritten on every build.",
  "terraform": {
    "required_providers": {
      "google": {
        "source": "hashicorp/google",
        "version": "~> 8.0"
      }
    }
  },
  "provider": {
    "google": {
      "default_labels": {
        "clowd-project": "shop"
      }
    }
  },
  "data": {
    "google_client_config": {
      "current": {}
    }
  },
  "resource": {
    "google_project_service": {
      "compute": {
        "disable_on_destroy": false,
        "service": "compute.googleapis.com"
      },
      "iam": {
        "disable_on_destroy": false,
        "service": "iam.googleapis.com"
      },
      "run": {
        "disable_on_destroy": false,
        "service": "run.googleapis.com"
      },
      "certificatemanager": {
        "disable_on_destroy": false,
        "service": "certificatemanager.googleapis.com"
      }
    },
    "google_compute_network": {
      "main": {
        "auto_create_subnetworks": false,
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop"
      }
    },
    "google_compute_subnetwork": {
      "main": {
        "depends_on": [
          "google_project_service.compute"
        ],
        "ip_cidr_range": "10.0.0.0/20",
        "name": "shop",
        "network": "${google_compute_network.main.id}",
        "private_ip_google_access": true,
        "region": "${data.google_client_config.current.region}"
      },
      "proxy": {
        "depends_on": [
          "google_project_service.compute"
        ],
        "ip_cidr_range": "10.0.32.0/20",
        "name": "shop-proxy",
        "network": "${google_compute_network.main.id}",
        "purpose": "REGIONAL_MANAGED_PROXY",
        "region": "${data.google_client_config.current.region}",
        "role": "ACTIVE"
      }
    },
    "google_service_account": {
      "api": {
        "account_id": "shop-api",
        "depends_on": [
          "google_project_service.iam"
        ],
        "display_name": "clowd service api"
      },
      "admin": {
        "account_id": "shop-admin",
        "depends_on": [
          "google_project_service.iam"
        ],
        "display_name": "clowd service admin"
      }
    },
    "google_cloud_run_v2_service": {
      "api": {
        "deletion_protection": false,
        "depends_on": [
          "google_project_service.run"
        ],
        "ingress": "INGRESS_TRAFFIC_INTERNAL_LOAD_BALANCER",
        "invoker_iam_disabled": true,
        "location": "${data.google_client_config.current.region}",
        "name": "shop-api",
        "template": {
          "containers": [
            {
              "env": [],
              "image": "a",
              "ports": {
                "container_port": 8080
              }
            }
          ],
          "scaling": {
            "max_instance_count": 1,
            "min_instance_count": 1
          },
          "service_account": "${google_service_account.api.email}"
        }
      },
      "admin": {
        "deletion_protection": false,
        "depends_on": [
          "google_project_service.run"
        ],
        "ingress": "INGRESS_TRAFFIC_INTERNAL_LOAD_BALANCER",
        "invoker_iam_disabled": true,
        "location": "${data.google_client_config.current.region}",
        "name": "shop-admin",
        "template": {
          "containers": [
            {
              "env": [],
              "image": "b",
              "liveness_probe": {
                "http_get": {
                  "path": "/healthz"
                }
              },
              "ports": {
                "container_port": 8080
              },
              "startup_probe": {
                "http_get": {
                  "path": "/healthz"
                }
              }
            }
          ],
          "scaling": {
            "max_instance_count": 1,
            "min_instance_count": 1
          },
          "service_account": "${google_service_account.admin.email}"
        }
      }
    },
    "google_compute_global_address": {
      "web": {
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-web"
      }
    },
    "google_compute_region_network_endpoint_group": {
      "web_admin": {
        "cloud_run": {
          "service": "${google_cloud_run_v2_service.admin.name}"
        },
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-web-admin",
        "network_endpoint_type": "SERVERLESS",
        "region": "${data.google_client_config.current.region}"
      },
      "web_api": {
        "cloud_run": {
          "service": "${google_cloud_run_v2_service.api.name}"
        },
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-web-api",
        "network_endpoint_type": "SERVERLESS",
        "region": "${data.google_client_config.current.region}"
      },
      "inner_api": {
        "cloud_run": {
          "service": "${google_cloud_run_v2_service.api.name}"
        },
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-inner-api",
        "network_endpoint_type": "SERVERLESS",
        "region": "${data.google_client_config.current.region}"
      }
    },
    "google_compute_backend_service": {
      "web_admin": {
        "backend": {
          "group": "${google_compute_region_network_endpoint_group.web_admin.id}"
        },
        "depends_on": [
          "google_project_service.compute"
        ],
        "load_balancing_scheme": "EXTERNAL_MANAGED",
        "name": "shop-web-admin",
        "protocol": "HTTP"
      },
      "web_api": {
        "backend": {
          "group": "${google_compute_region_network_endpoint_group.web_api.id}"
        },
        "depends_on": [
          "google_project_service.compute"
        ],
        "load_balancing_scheme": "EXTERNAL_MANAGED",
        "name": "shop-web-api",
        "protocol": "HTTP"
      }
    },
    "google_compute_url_map": {
      "web": {
        "default_service": "${google_compute_backend_service.web_admin.id}",
        "depends_on": [
          "google_project_service.compute"
        ],
        "host_rule": {
          "hosts": [
            "*"
          ],
          "path_matcher": "routes"
        },
        "name": "shop-web",
        "path_matcher": {
          "default_service": "${google_compute_backend_service.web_admin.id}",
          "name": "routes",
          "route_rules": [
            {
              "match_rules": {
                "prefix_match": "/admin"
              },
              "priority": 1,
              "service": "${google_compute_backend_service.web_admin.id}"
            },
            {
              "match_rules": {
                "prefix_match": "/api"
              },
              "priority": 2,
              "service": "${google_compute_backend_service.web_api.id}"
            }
          ]
        }
      }
    },
    "google_certificate_manager_dns_authorization": {
      "web_wildcard_example_com": {
        "depends_on": [
          "google_project_service.certificatemanager"
        ],
        "domain": "example.com",
        "name": "shop-web-wildcard-example-com"
      },
      "inner_inner_example_com": {
        "depends_on": [
          "google_project_service.certificatemanager"
        ],
        "domain": "inner.example.com",
        "location": "${data.google_client_config.current.region}",
        "name": "shop-inner-inner-example-com",
        "type": "PER_PROJECT_RECORD"
      }
    },
    "google_certificate_manager_certificate": {
      "web_wildcard_example_com": {
        "depends_on": [
          "google_project_service.certificatemanager"
        ],
        "lifecycle": {
          "create_before_destroy": true
        },
        "managed": {
          "dns_authorizations": [
            "${google_certificate_manager_dns_authorization.web_wildcard_example_com.id}"
          ],
          "domains": [
            "*.example.com"
          ]
        },
        "name": "shop-web-wildcard-example-com"
      },
      "inner_inner_example_com": {
        "depends_on": [
          "google_project_service.certificatemanager"
        ],
        "lifecycle": {
          "create_before_destroy": true
        },
        "location": "${data.google_client_config.current.region}",
        "managed": {
          "dns_authorizations": [
            "${google_certificate_manager_dns_authorization.inner_inner_example_com.id}"
          ],
          "domains": [
            "inner.example.com"
          ]
        },
        "name": "shop-inner-inner-example-com"
      }
    },
    "google_compute_target_https_proxy": {
      "web_443": {
        "certificate_manager_certificates": [
          "${google_certificate_manager_certificate.web_wildcard_example_com.id}"
        ],
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-web-443",
        "url_map": "${google_compute_url_map.web.id}"
      }
    },
    "google_compute_global_forwarding_rule": {
      "web_443": {
        "depends_on": [
          "google_project_service.compute"
        ],
        "ip_address": "${google_compute_global_address.web.id}",
        "ip_protocol": "TCP",
        "load_balancing_scheme": "EXTERNAL_MANAGED",
        "name": "shop-web-443",
        "port_range": "443",
        "target": "${google_compute_target_https_proxy.web_443.id}"
      },
      "web_8080": {
        "depends_on": [
          "google_project_service.compute"
        ],
        "ip_address": "${google_compute_global_address.web.id}",
        "ip_protocol": "TCP",
        "load_balancing_scheme": "EXTERNAL_MANAGED",
        "name": "shop-web-8080",
        "port_range": "8080",
        "target": "${google_compute_target_http_proxy.web_8080.id}"
      }
    },
    "google_compute_target_http_proxy": {
      "web_8080": {
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-web-8080",
        "url_map": "${google_compute_url_map.web.id}"
      }
    },
    "google_compute_address": {
      "inner": {
        "address_type": "INTERNAL",
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-inner",
        "purpose": "SHARED_LOADBALANCER_VIP",
        "region": "${data.google_client_config.current.region}",
        "subnetwork": "${google_compute_subnetwork.main.id}"
      }
    },
    "google_compute_region_backend_service": {
      "inner_api": {
        "backend": {
          "balancing_mode": "UTILIZATION",
          "capacity_scaler": 1,
          "group": "${google_compute_region_network_endpoint_group.inner_api.id}"
        },
        "depends_on": [
          "google_project_service.compute"
        ],
        "load_balancing_scheme": "INTERNAL_MANAGED",
        "name": "shop-inner-api",
        "protocol": "HTTP",
        "region": "${data.google_client_config.current.region}"
      }
    },
    "google_compute_region_url_map": {
      "inner": {
        "default_service": "${google_compute_region_backend_service.inner_api.id}",
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-inner",
        "region": "${data.google_client_config.current.region}"
      }
    },
    "google_compute_region_target_https_proxy": {
      "inner_443": {
        "certificate_manager_certificates": [
          "${google_certificate_manager_certificate.inner_inner_example_com.id}"
        ],
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-inner-443",
        "region": "${data.google_client_config.current.region}",
        "url_map": "${google_compute_region_url_map.inner.id}"
      }
    },
    "google_compute_forwarding_rule": {
      "inner_443": {
        "depends_on": [
          "google_compute_subnetwork.proxy",
          "google_project_service.compute"
        ],
        "ip_address": "${google_compute_address.inner.id}",
        "ip_protocol": "TCP",
        "load_balancing_scheme": "INTERNAL_MANAGED",
        "name": "shop-inner-443",
        "network": "${google_compute_network.main.id}",
        "port_range": "443",
        "region": "${data.google_client_config.current.region}",
        "subnetwork": "${google_compute_subnetwork.main.id}",
        "target": "${google_compute_region_target_https_proxy.inner_443.id}"
      },
      "inner_9000": {
        "depends_on": [
          "google_compute_subnetwork.proxy",
          "google_project_service.compute"
        ],
        "ip_address": "${google_compute_address.inner.id}",
        "ip_protocol": "TCP",
        "load_balancing_scheme": "INTERNAL_MANAGED",
        "name": "shop-inner-9000",
        "network": "${google_compute_network.main.id}",
        "port_range": "9000",
        "region": "${data.google_client_config.current.region}",
        "subnetwork": "${google_compute_subnetwork.main.id}",
        "target": "${google_compute_region_target_http_proxy.inner_9000.id}"
      }
    },
    "google_compute_region_target_http_proxy": {
      "inner_9000": {
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-inner-9000",
        "region": "${data.google_client_config.current.region}",
        "url_map": "${google_compute_region_url_map.inner.id}"
      }
    }
  },
  "output": {
    "web_wildcard_example_com_validation": {
      "description": "The DNS record that proves you own *.example.com",
      "value": "${google_certificate_manager_dns_authorization.web_wildcard_example_com.dns_resource_record[0].type} ${google_certificate_manager_dns_authorization.web_wildcard_example_com.dns_resource_record[0].name} → ${google_certificate_manager_dns_authorization.web_wildcard_example_com.dns_resource_record[0].data}"
    },
    "web_ip_address": {
      "description": "The IP address of load balancer web; point your domains at it with an A record",
      "value": "${google_compute_global_address.web.address}"
    },
    "web_url": {
      "description": "Where load balancer web serves",
      "value": "https://*.example.com"
    },
    "inner_inner_example_com_validation": {
      "description": "The DNS record that proves you own inner.example.com",
      "value": "${google_certificate_manager_dns_authorization.inner_inner_example_com.dns_resource_record[0].type} ${google_certificate_manager_dns_authorization.inner_inner_example_com.dns_resource_record[0].name} → ${google_certificate_manager_dns_authorization.inner_inner_example_com.dns_resource_record[0].data}"
    },
    "inner_ip_address": {
      "description": "The IP address of load balancer inner; point your domains at it with an A record",
      "value": "${google_compute_address.inner.address}"
    },
    "inner_url": {
      "description": "Where load balancer inner serves",
      "value": "https://inner.example.com"
    }
  }
}
