          "google_project_service.certificatemanager"
        ],
        "domain": "api.example.com",
        "name": "shop-web-api-example-com"
      }
    },
    "google_certificate_manager_certificate": {
      "web_api_example_com": {
        "depends_on": [
          "google_project_service.certificatemanager"
        ],
        "lifecycle": {
          "create_before_destroy": true
        },
        "managed": {
          "dns_authorizations": [
            "${google_certificate_manager_dns_authorization.web_api_example_com.id}"
          ],
          "domains": [
            "api.example.com"
          ]
        },
        "name": "shop-web-api-example-com"
      }
    },
    "google_compute_target_https_proxy": {
      "web_443": {
        "certificate_manager_certificates": [
          "${google_certificate_manager_certificate.web_api_example_com.id}"
        ],
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-web-443",
        "url_map": "${google_compute_url_map.web.id}"
      }
    },
    "google_compute_global_forwarding_rule": {
      "web_443": {
        "depends_on": [
          "google_project_service.compute"
        ],
        "ip_address": "${google_compute_global_address.web.id}",
        "ip_protocol": "TCP",
        "load_balancing_scheme": "EXTERNAL_MANAGED",
        "name": "shop-web-443",
        "port_range": "443",
        "target": "${google_compute_target_https_proxy.web_443.id}"
      },
      "web_80": {
        "depends_on": [
          "google_project_service.compute"
        ],
        "ip_address": "${google_compute_global_address.web.id}",
        "ip_protocol": "TCP",
        "load_balancing_scheme": "EXTERNAL_MANAGED",
        "name": "shop-web-80",
        "port_range": "80",
        "target": "${google_compute_target_http_proxy.web_80.id}"
      }
    },
    "google_compute_target_http_proxy": {
      "web_80": {
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-web-80",
        "url_map": "${google_compute_url_map.web.id}"
      }
    },
    "google_compute_address": {
      "internal_lb": {
        "address_type": "INTERNAL",
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-internal-lb",
        "purpose": "SHARED_LOADBALANCER_VIP",
        "region": "us-central1",
        "subnetwork": "${google_compute_subnetwork.main.id}"
      }
    },
    "google_compute_region_backend_service": {
      "internal_lb_worker": {
        "backend": {
          "balancing_mode": "UTILIZATION",
          "capacity_scaler": 1,
          "group": "${google_compute_region_network_endpoint_group.internal_lb_worker.id}"
        },
        "depends_on": [
          "google_project_service.compute"
        ],
        "load_balancing_scheme": "INTERNAL_MANAGED",
        "name": "shop-internal-lb-worker",
        "protocol": "HTTP",
        "region": "us-central1"
      }
    },
    "google_compute_region_url_map": {
      "internal_lb": {
        "default_service": "${google_compute_region_backend_service.internal_lb_worker.id}",
        "depends_on": [
          "google_project_service.compute"
        ],
        "host_rule": {
          "hosts": [
            "*"
          ],
          "path_matcher": "routes"
        },
        "name": "shop-internal-lb",
        "path_matcher": {
          "default_service": "${google_compute_region_backend_service.internal_lb_worker.id}",
          "name": "routes",
          "route_rules": [
            {
              "match_rules": {
                "prefix_match": "/status"
              },
              "priority": 1,
              "service": "${google_compute_region_backend_service.internal_lb_worker.id}"
            }
          ]
        },
        "region": "us-central1"
      }
    },
    "google_compute_region_target_http_proxy": {
      "internal_lb_8080": {
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-internal-lb-8080",
        "region": "us-central1",
        "url_map": "${google_compute_region_url_map.internal_lb.id}"
      }
    },
    "google_compute_forwarding_rule": {
      "internal_lb_8080": {
        "depends_on": [
          "google_compute_subnetwork.proxy",
          "google_project_service.compute"
        ],
        "ip_address": "${google_compute_address.internal_lb.id}",
        "ip_protocol": "TCP",
        "load_balancing_scheme": "INTERNAL_MANAGED",
        "name": "shop-internal-lb-8080",
        "network": "${google_compute_network.main.id}",
        "port_range": "8080",
        "region": "us-central1",
        "subnetwork": "${google_compute_subnetwork.main.id}",
        "target": "${google_compute_region_target_http_proxy.internal_lb_8080.id}"
      }
    }
  },
  "output": {
    "uploads_bucket": {
      "description": "The name of bucket uploads",
      "value": "${google_storage_bucket.uploads.name}"
    },
    "assets_bucket": {
      "description": "The name of bucket assets",
      "value": "${google_storage_bucket.assets.name}"
    },
    "web_api_example_com_validation": {
      "description": "The DNS record that proves you own api.example.com",
      "value": "${google_certificate_manager_dns_authorization.web_api_example_com.dns_resource_record[0].type} ${google_certificate_manager_dns_authorization.web_api_example_com.dns_resource_record[0].name} → ${google_certificate_manager_dns_authorization.web_api_example_com.dns_resource_record[0].data}"
    },
    "web_ip_address": {
      "description": "The IP address of load balancer web; point your domains at it with an A record",
      "value": "${google_compute_global_address.web.address}"
    },
    "web_url": {
      "description": "Where load balancer web serves",
      "value": "https://api.example.com"
    },
    "internal_lb_ip_address": {
      "description": "The IP address of load balancer internal_lb; point your domains at it with an A record",
      "value": "${google_compute_address.internal_lb.address}"
    },
    "internal_lb_url": {
      "description": "Where load balancer internal_lb serves",
      "value": "http://${google_compute_address.internal_lb.address}:8080"
    }
  }
}
