{
  "//": "Generated by clowd from app.clowd. Edit that file instead: this one is rewritten on every build.",
  "terraform": {
    "required_providers": {
      "google": {
        "source": "hashicorp/google",
        "version": "~> 8.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.7"
      }
    }
  },
  "provider": {
    "google": {
      "default_labels": {
        "clowd-project": "shop"
      },
      "region": "europe-west2"
    }
  },
  "ephemeral": {
    "random_password": {
      "db": {
        "length": 32,
        "special": false
      }
    }
  },
  "resource": {
    "google_project_service": {
      "compute": {
        "disable_on_destroy": false,
        "service": "compute.googleapis.com"
      },
      "servicenetworking": {
        "disable_on_destroy": false,
        "service": "servicenetworking.googleapis.com"
      },
      "sqladmin": {
        "disable_on_destroy": false,
        "service": "sqladmin.googleapis.com"
      },
      "secretmanager": {
        "disable_on_destroy": false,
        "service": "secretmanager.googleapis.com"
      },
      "storage": {
        "disable_on_destroy": false,
        "service": "storage.googleapis.com"
      },
      "iam": {
        "disable_on_destroy": false,
        "service": "iam.googleapis.com"
      },
      "artifactregistry": {
        "disable_on_destroy": false,
        "service": "artifactregistry.googleapis.com"
      },
      "run": {
        "disable_on_destroy": false,
        "service": "run.googleapis.com"
      },
      "certificatemanager": {
        "disable_on_destroy": false,
        "service": "certificatemanager.googleapis.com"
      }
    },
    "google_compute_network": {
      "main": {
        "auto_create_subnetworks": false,
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop"
      }
    },
    "google_compute_subnetwork": {
      "main": {
        "depends_on": [
          "google_project_service.compute"
        ],
        "ip_cidr_range": "10.0.0.0/20",
        "name": "shop",
        "network": "${google_compute_network.main.id}",
        "private_ip_google_access": true,
        "region": "europe-west2"
      }
    },
    "google_compute_global_address": {
      "private_services": {
        "address": "10.0.16.0",
        "address_type": "INTERNAL",
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-private-services",
        "network": "${google_compute_network.main.id}",
        "prefix_length": 20,
        "purpose": "VPC_PEERING"
      },
      "web": {
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-web"
      }
    },
    "google_service_networking_connection": {
      "private_services": {
        "deletion_policy": "ABANDON",
        "depends_on": [
          "google_project_service.servicenetworking"
        ],
        "network": "${google_compute_network.main.id}",
        "reserved_peering_ranges": [
          "${google_compute_global_address.private_services.name}"
        ],
        "service": "servicenetworking.googleapis.com"
      }
    },
    "random_id": {
      "db": {
        "byte_length": 2
      },
      "uploads": {
        "byte_length": 4
      }
    },
    "google_sql_database_instance": {
      "db": {
        "database_version": "POSTGRES_16",
        "deletion_protection": false,
        "depends_on": [
          "google_service_networking_connection.private_services",
          "google_project_service.sqladmin"
        ],
        "name": "shop-db-${random_id.db.hex}",
        "region": "europe-west2",
        "settings": {
          "availability_type": "ZONAL",
          "deletion_protection_enabled": false,
          "edition": "ENTERPRISE",
          "ip_configuration": {
            "ipv4_enabled": false,
            "private_network": "${google_compute_network.main.id}"
          },
          "tier": "db-g1-small",
          "user_labels": {
            "clowd-project": "shop"
          }
        }
      }
    },
    "google_sql_database": {
      "db": {
        "deletion_policy": "ABANDON",
        "depends_on": [
          "google_project_service.sqladmin"
        ],
        "instance": "${google_sql_database_instance.db.name}",
        "name": "db_db"
      }
    },
    "google_sql_user": {
      "db": {
        "deletion_policy": "ABANDON",
        "depends_on": [
          "google_project_service.sqladmin"
        ],
        "instance": "${google_sql_database_instance.db.name}",
        "name": "clowd",
        "password_wo": "${ephemeral.random_password.db.result}",
        "password_wo_version": 1
      }
    },
    "google_secret_manager_secret": {
      "db_password": {
        "depends_on": [
          "google_project_service.secretmanager"
        ],
        "replication": {
          "auto": {}
        },
        "secret_id": "shop-db-password"
      }
    },
    "google_secret_manager_secret_version": {
      "db_password": {
        "depends_on": [
          "google_project_service.secretmanager"
        ],
        "secret": "${google_secret_manager_secret.db_password.id}",
        "secret_data_wo": "${ephemeral.random_password.db.result}",
        "secret_data_wo_version": "1"
      }
    },
    "google_storage_bucket": {
      "uploads": {
        "depends_on": [
          "google_project_service.storage"
        ],
        "force_destroy": true,
        "location": "EUROPE-WEST2",
        "name": "shop-uploads-${random_id.uploads.hex}",
        "public_access_prevention": "enforced",
        "uniform_bucket_level_access": true
      }
    },
    "google_service_account": {
      "api": {
        "account_id": "shop-api",
        "depends_on": [
          "google_project_service.iam"
        ],
        "display_name": "clowd service api"
      }
    },
    "google_secret_manager_secret_iam_member": {
      "api_db_password": {
        "depends_on": [
          "google_project_service.secretmanager"
        ],
        "member": "serviceAccount:${google_service_account.api.email}",
        "role": "roles/secretmanager.secretAccessor",
        "secret_id": "${google_secret_manager_secret.db_password.id}"
      }
    },
    "google_storage_bucket_iam_member": {
      "api_uploads": {
        "bucket": "${google_storage_bucket.uploads.name}",
        "depends_on": [
          "google_project_service.storage"
        ],
        "member": "serviceAccount:${google_service_account.api.email}",
        "role": "roles/storage.objectUser"
      }
    },
    "google_artifact_registry_repository": {
      "ghcr_io": {
        "depends_on": [
          "google_project_service.artifactregistry"
        ],
        "description": "images from ghcr.io, for Cloud Run",
        "format": "DOCKER",
        "location": "europe-west2",
        "mode": "REMOTE_REPOSITORY",
        "remote_repository_config": {
          "docker_repository": {
            "custom_repository": {
              "uri": "https://ghcr.io"
            }
          }
        },
        "repository_id": "shop-ghcr-io"
      }
    },
    "google_cloud_run_v2_service": {
      "api": {
        "deletion_protection": false,
        "depends_on": [
          "google_secret_manager_secret_iam_member.api_db_password",
          "google_secret_manager_secret_version.db_password",
          "google_project_service.run"
        ],
        "ingress": "INGRESS_TRAFFIC_INTERNAL_LOAD_BALANCER",
        "invoker_iam_disabled": true,
        "location": "europe-west2",
        "name": "shop-api",
        "template": {
          "containers": [
            {
              "env": [
                {
                  "name": "DB_HOST",
                  "value": "${google_sql_database_instance.db.private_ip_address}"
                },
                {
                  "name": "DB_PORT",
                  "value": "5432"
                },
                {
                  "name": "DB_NAME",
                  "value": "db_db"
                },
                {
                  "name": "DB_USER",
                  "value": "clowd"
                },
                {
                  "name": "DB_PASSWORD",
                  "value_source": {
                    "secret_key_ref": {
                      "secret": "${google_secret_manager_secret.db_password.secret_id}",
                      "version": "latest"
                    }
                  }
                },
                {
                  "name": "UPLOADS_BUCKET",
                  "value": "${google_storage_bucket.uploads.name}"
                }
              ],
              "image": "${google_artifact_registry_repository.ghcr_io.registry_uri}/me/api:latest",
              "ports": {
                "container_port": 8080
              }
            }
          ],
          "scaling": {
            "max_instance_count": 10,
            "min_instance_count": 2
          },
          "service_account": "${google_service_account.api.email}",
          "vpc_access": {
            "egress": "PRIVATE_RANGES_ONLY",
            "network_interfaces": {
              "network": "${google_compute_network.main.id}",
              "subnetwork": "${google_compute_subnetwork.main.id}"
            }
          }
        }
      }
    },
    "google_compute_region_network_endpoint_group": {
      "web_api": {
        "cloud_run": {
          "service": "${google_cloud_run_v2_service.api.name}"
        },
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-web-api",
        "network_endpoint_type": "SERVERLESS",
        "region": "europe-west2"
      }
    },
    "google_compute_backend_service": {
      "web_api": {
        "backend": {
          "group": "${google_compute_region_network_endpoint_group.web_api.id}"
        },
        "depends_on": [
          "google_project_service.compute"
        ],
        "load_balancing_scheme": "EXTERNAL_MANAGED",
        "name": "shop-web-api",
        "protocol": "HTTP"
      }
    },
    "google_compute_url_map": {
      "web": {
        "default_service": "${google_compute_backend_service.web_api.id}",
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-web"
      }
    },
    "google_certificate_manager_dns_authorization": {
      "web_api_example_com": {
        "depends_on": [
          "google_project_service.certificatemanager"
        ],
        "domain": "api.example.com",
        "name": "shop-web-api-example-com"
      }
    },
    "google_certificate_manager_certificate": {
      "web_api_example_com": {
        "depends_on": [
          "google_project_service.certificatemanager"
        ],
        "lifecycle": {
          "create_before_destroy": true
        },
        "managed": {
          "dns_authorizations": [
            "${google_certificate_manager_dns_authorization.web_api_example_com.id}"
          ],
          "domains": [
            "api.example.com"
          ]
        },
        "name": "shop-web-api-example-com"
      }
    },
    "google_compute_target_https_proxy": {
      "web_443": {
        "certificate_manager_certificates": [
          "${google_certificate_manager_certificate.web_api_example_com.id}"
        ],
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-web-443",
        "url_map": "${google_compute_url_map.web.id}"
      }
    },
    "google_compute_global_forwarding_rule": {
      "web_443": {
        "depends_on": [
          "google_project_service.compute"
        ],
        "ip_address": "${google_compute_global_address.web.id}",
        "ip_protocol": "TCP",
        "load_balancing_scheme": "EXTERNAL_MANAGED",
        "name": "shop-web-443",
        "port_range": "443",
        "target": "${google_compute_target_https_proxy.web_443.id}"
      }
    }
  },
  "output": {
    "uploads_bucket": {
      "description": "The name of bucket uploads",
      "value": "${google_storage_bucket.uploads.name}"
    },
    "web_api_example_com_validation": {
      "description": "The DNS record that proves you own api.example.com",
      "value": "${google_certificate_manager_dns_authorization.web_api_example_com.dns_resource_record[0].type} ${google_certificate_manager_dns_authorization.web_api_example_com.dns_resource_record[0].name} → ${google_certificate_manager_dns_authorization.web_api_example_com.dns_resource_record[0].data}"
    },
    "web_ip_address": {
      "description": "The IP address of load balancer web; point your domains at it with an A record",
      "value": "${google_compute_global_address.web.address}"
    },
    "web_url": {
      "description": "Where load balancer web serves",
      "value": "https://api.example.com"
    }
  }
}
