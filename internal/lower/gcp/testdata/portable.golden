{
  "//": "Generated by clowd from portable.clowd. Edit that file instead: this one is rewritten on every build.",
  "terraform": {
    "required_providers": {
      "google": {
        "source": "hashicorp/google",
        "version": "~> 8.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.7"
      }
    }
  },
  "provider": {
    "google": {
      "default_labels": {
        "clowd-project": "shop"
      },
      "region": "europe-west2"
    }
  },
  "data": {
    "google_project": {
      "current": {}
    }
  },
  "ephemeral": {
    "random_password": {
      "db": {
        "length": 32,
        "special": false
      },
      "scratch": {
        "length": 32,
        "special": false
      }
    }
  },
  "resource": {
    "google_project_service": {
      "compute": {
        "disable_on_destroy": false,
        "service": "compute.googleapis.com"
      },
      "servicenetworking": {
        "disable_on_destroy": false,
        "service": "servicenetworking.googleapis.com"
      },
      "iam": {
        "disable_on_destroy": false,
        "service": "iam.googleapis.com"
      },
      "run": {
        "disable_on_destroy": false,
        "service": "run.googleapis.com"
      },
      "sqladmin": {
        "disable_on_destroy": false,
        "service": "sqladmin.googleapis.com"
      },
      "secretmanager": {
        "disable_on_destroy": false,
        "service": "secretmanager.googleapis.com"
      },
      "storage": {
        "disable_on_destroy": false,
        "service": "storage.googleapis.com"
      },
      "pubsub": {
        "disable_on_destroy": false,
        "service": "pubsub.googleapis.com"
      }
    },
    "google_compute_network": {
      "main": {
        "auto_create_subnetworks": false,
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop"
      }
    },
    "google_compute_subnetwork": {
      "main": {
        "depends_on": [
          "google_project_service.compute"
        ],
        "ip_cidr_range": "10.0.0.0/20",
        "name": "shop",
        "network": "${google_compute_network.main.id}",
        "private_ip_google_access": true,
        "region": "europe-west2"
      }
    },
    "google_compute_global_address": {
      "private_services": {
        "address": "10.0.16.0",
        "address_type": "INTERNAL",
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-private-services",
        "network": "${google_compute_network.main.id}",
        "prefix_length": 20,
        "purpose": "VPC_PEERING"
      },
      "web": {
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-web"
      }
    },
    "google_service_networking_connection": {
      "private_services": {
        "deletion_policy": "ABANDON",
        "depends_on": [
          "google_project_service.servicenetworking"
        ],
        "network": "${google_compute_network.main.id}",
        "reserved_peering_ranges": [
          "${google_compute_global_address.private_services.name}"
        ],
        "service": "servicenetworking.googleapis.com"
      }
    },
    "google_service_account": {
      "api": {
        "account_id": "shop-api",
        "depends_on": [
          "google_project_service.iam"
        ],
        "display_name": "clowd service api"
      },
      "worker": {
        "account_id": "shop-worker",
        "depends_on": [
          "google_project_service.iam"
        ],
        "display_name": "clowd service worker"
      }
    },
    "google_cloud_run_v2_service": {
      "api": {
        "deletion_protection": false,
        "depends_on": [
          "google_project_service.run"
        ],
        "ingress": "INGRESS_TRAFFIC_INTERNAL_LOAD_BALANCER",
        "invoker_iam_disabled": true,
        "location": "europe-west2",
        "name": "shop-api",
        "template": {
          "containers": [
            {
              "args": [
                "./server",
                "--port",
                "8080"
              ],
              "env": [],
              "image": "a",
              "liveness_probe": {
                "http_get": {
                  "path": "/healthz"
                }
              },
              "ports": {
                "container_port": 8080
              },
              "startup_probe": {
                "http_get": {
                  "path": "/healthz"
                }
              }
            }
          ],
          "scaling": {
            "max_instance_count": 1,
            "min_instance_count": 1
          },
          "service_account": "${google_service_account.api.email}"
        }
      },
      "worker": {
        "deletion_protection": false,
        "depends_on": [
          "google_project_service.run"
        ],
        "ingress": "INGRESS_TRAFFIC_INTERNAL_ONLY",
        "location": "europe-west2",
        "name": "shop-worker",
        "template": {
          "containers": [
            {
              "env": [],
              "image": "b",
              "liveness_probe": {
                "http_get": {
                  "path": "/up"
                }
              },
              "ports": {
                "container_port": 8080
              },
              "startup_probe": {
                "http_get": {
                  "path": "/up"
                }
              }
            }
          ],
          "scaling": {
            "max_instance_count": 1,
            "min_instance_count": 1
          },
          "service_account": "${google_service_account.worker.email}"
        }
      }
    },
    "google_compute_region_network_endpoint_group": {
      "web_api": {
        "cloud_run": {
          "service": "${google_cloud_run_v2_service.api.name}"
        },
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-web-api",
        "network_endpoint_type": "SERVERLESS",
        "region": "europe-west2"
      }
    },
    "google_compute_backend_service": {
      "web_api": {
        "backend": {
          "group": "${google_compute_region_network_endpoint_group.web_api.id}"
        },
        "depends_on": [
          "google_project_service.compute"
        ],
        "load_balancing_scheme": "EXTERNAL_MANAGED",
        "name": "shop-web-api",
        "protocol": "HTTP"
      }
    },
    "google_compute_url_map": {
      "web": {
        "default_service": "${google_compute_backend_service.web_api.id}",
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-web"
      }
    },
    "google_compute_target_http_proxy": {
      "web_80": {
        "depends_on": [
          "google_project_service.compute"
        ],
        "name": "shop-web-80",
        "url_map": "${google_compute_url_map.web.id}"
      }
    },
    "google_compute_global_forwarding_rule": {
      "web_80": {
        "depends_on": [
          "google_project_service.compute"
        ],
        "ip_address": "${google_compute_global_address.web.id}",
        "ip_protocol": "TCP",
        "load_balancing_scheme": "EXTERNAL_MANAGED",
        "name": "shop-web-80",
        "port_range": "80",
        "target": "${google_compute_target_http_proxy.web_80.id}"
      }
    },
    "random_id": {
      "db": {
        "byte_length": 2
      },
      "scratch": {
        "byte_length": 2
      },
      "uploads": {
        "byte_length": 4
      },
      "tmp": {
        "byte_length": 4
      }
    },
    "google_sql_database_instance": {
      "db": {
        "database_version": "POSTGRES_16",
        "deletion_protection": true,
        "depends_on": [
          "google_service_networking_connection.private_services",
          "google_project_service.sqladmin"
        ],
        "name": "shop-db-${random_id.db.hex}",
        "region": "europe-west2",
        "settings": {
          "availability_type": "REGIONAL",
          "backup_configuration": {
            "backup_retention_settings": {
              "retained_backups": 14,
              "retention_unit": "COUNT"
            },
            "enabled": true,
            "point_in_time_recovery_enabled": true
          },
          "deletion_protection_enabled": true,
          "disk_size": 50,
          "edition": "ENTERPRISE",
          "final_backup_config": {
            "enabled": true,
            "retention_days": 30
          },
          "ip_configuration": {
            "ipv4_enabled": false,
            "private_network": "${google_compute_network.main.id}"
          },
          "tier": "db-g1-small",
          "user_labels": {
            "clowd-project": "shop"
          }
        }
      },
      "scratch": {
        "database_version": "POSTGRES_17",
        "deletion_protection": false,
        "depends_on": [
          "google_service_networking_connection.private_services",
          "google_project_service.sqladmin"
        ],
        "name": "shop-scratch-${random_id.scratch.hex}",
        "region": "europe-west2",
        "settings": {
          "availability_type": "ZONAL",
          "backup_configuration": {
            "enabled": false
          },
          "deletion_protection_enabled": false,
          "edition": "ENTERPRISE",
          "ip_configuration": {
            "ipv4_enabled": false,
            "private_network": "${google_compute_network.main.id}"
          },
          "tier": "db-g1-small",
          "user_labels": {
            "clowd-project": "shop"
          }
        }
      }
    },
    "google_sql_database": {
      "db": {
        "deletion_policy": "ABANDON",
        "depends_on": [
          "google_project_service.sqladmin"
        ],
        "instance": "${google_sql_database_instance.db.name}",
        "name": "db_db"
      },
      "scratch": {
        "deletion_policy": "ABANDON",
        "depends_on": [
          "google_project_service.sqladmin"
        ],
        "instance": "${google_sql_database_instance.scratch.name}",
        "name": "scratch_db"
      }
    },
    "google_sql_user": {
      "db": {
        "deletion_policy": "ABANDON",
        "depends_on": [
          "google_project_service.sqladmin"
        ],
        "instance": "${google_sql_database_instance.db.name}",
        "name": "clowd",
        "password_wo": "${ephemeral.random_password.db.result}",
        "password_wo_version": 1
      },
      "scratch": {
        "deletion_policy": "ABANDON",
        "depends_on": [
          "google_project_service.sqladmin"
        ],
        "instance": "${google_sql_database_instance.scratch.name}",
        "name": "clowd",
        "password_wo": "${ephemeral.random_password.scratch.result}",
        "password_wo_version": 1
      }
    },
    "google_secret_manager_secret": {
      "db_password": {
        "depends_on": [
          "google_project_service.secretmanager"
        ],
        "replication": {
          "auto": {}
        },
        "secret_id": "shop-db-password"
      },
      "scratch_password": {
        "depends_on": [
          "google_project_service.secretmanager"
        ],
        "replication": {
          "auto": {}
        },
        "secret_id": "shop-scratch-password"
      }
    },
    "google_secret_manager_secret_version": {
      "db_password": {
        "depends_on": [
          "google_project_service.secretmanager"
        ],
        "secret": "${google_secret_manager_secret.db_password.id}",
        "secret_data_wo": "${ephemeral.random_password.db.result}",
        "secret_data_wo_version": "1"
      },
      "scratch_password": {
        "depends_on": [
          "google_project_service.secretmanager"
        ],
        "secret": "${google_secret_manager_secret.scratch_password.id}",
        "secret_data_wo": "${ephemeral.random_password.scratch.result}",
        "secret_data_wo_version": "1"
      }
    },
    "google_storage_bucket": {
      "uploads": {
        "depends_on": [
          "google_project_service.storage"
        ],
        "force_destroy": false,
        "lifecycle_rule": [
          {
            "action": {
              "type": "Delete"
            },
            "condition": {
              "age": 30
            }
          },
          {
            "action": {
              "type": "Delete"
            },
            "condition": {
              "days_since_noncurrent_time": 30,
              "with_state": "ARCHIVED"
            }
          }
        ],
        "location": "EUROPE-WEST2",
        "name": "shop-uploads-${random_id.uploads.hex}",
        "public_access_prevention": "enforced",
        "uniform_bucket_level_access": true,
        "versioning": {
          "enabled": true
        }
      },
      "tmp": {
        "depends_on": [
          "google_project_service.storage"
        ],
        "force_destroy": true,
        "lifecycle_rule": [
          {
            "action": {
              "type": "Delete"
            },
            "condition": {
              "age": 1
            }
          }
        ],
        "location": "EUROPE-WEST2",
        "name": "shop-tmp-${random_id.tmp.hex}",
        "public_access_prevention": "enforced",
        "uniform_bucket_level_access": true
      }
    },
    "google_pubsub_topic": {
      "jobs": {
        "depends_on": [
          "google_project_service.pubsub"
        ],
        "name": "shop-jobs"
      },
      "jobs_dead": {
        "depends_on": [
          "google_project_service.pubsub"
        ],
        "name": "shop-jobs-dead"
      },
      "events": {
        "depends_on": [
          "google_project_service.pubsub"
        ],
        "name": "shop-events"
      },
      "events_dead": {
        "depends_on": [
          "google_project_service.pubsub"
        ],
        "name": "shop-events-dead"
      }
    },
    "google_pubsub_subscription": {
      "jobs_dead": {
        "depends_on": [
          "google_project_service.pubsub"
        ],
        "expiration_policy": {
          "ttl": ""
        },
        "message_retention_duration": "2678400s",
        "name": "shop-jobs-dead",
        "topic": "${google_pubsub_topic.jobs_dead.id}"
      },
      "jobs": {
        "ack_deadline_seconds": 120,
        "dead_letter_policy": {
          "dead_letter_topic": "${google_pubsub_topic.jobs_dead.id}",
          "max_delivery_attempts": 5
        },
        "depends_on": [
          "google_project_service.pubsub"
        ],
        "expiration_policy": {
          "ttl": ""
        },
        "message_retention_duration": "345600s",
        "name": "shop-jobs",
        "topic": "${google_pubsub_topic.jobs.id}"
      },
      "events_dead": {
        "depends_on": [
          "google_project_service.pubsub"
        ],
        "expiration_policy": {
          "ttl": ""
        },
        "message_retention_duration": "2678400s",
        "name": "shop-events-dead",
        "topic": "${google_pubsub_topic.events_dead.id}"
      },
      "events": {
        "dead_letter_policy": {
          "dead_letter_topic": "${google_pubsub_topic.events_dead.id}",
          "max_delivery_attempts": 5
        },
        "depends_on": [
          "google_project_service.pubsub"
        ],
        "enable_exactly_once_delivery": true,
        "enable_message_ordering": true,
        "expiration_policy": {
          "ttl": ""
        },
        "name": "shop-events",
        "topic": "${google_pubsub_topic.events.id}"
      }
    },
    "google_pubsub_topic_iam_member": {
      "jobs_dead_letters": {
        "depends_on": [
          "google_project_service.pubsub"
        ],
        "member": "serviceAccount:service-${data.google_project.current.number}@gcp-sa-pubsub.iam.gserviceaccount.com",
        "role": "roles/pubsub.publisher",
        "topic": "${google_pubsub_topic.jobs_dead.name}"
      },
      "events_dead_letters": {
        "depends_on": [
          "google_project_service.pubsub"
        ],
        "member": "serviceAccount:service-${data.google_project.current.number}@gcp-sa-pubsub.iam.gserviceaccount.com",
        "role": "roles/pubsub.publisher",
        "topic": "${google_pubsub_topic.events_dead.name}"
      }
    },
    "google_pubsub_subscription_iam_member": {
      "jobs_dead_letters": {
        "depends_on": [
          "google_project_service.pubsub"
        ],
        "member": "serviceAccount:service-${data.google_project.current.number}@gcp-sa-pubsub.iam.gserviceaccount.com",
        "role": "roles/pubsub.subscriber",
        "subscription": "${google_pubsub_subscription.jobs.name}"
      },
      "events_dead_letters": {
        "depends_on": [
          "google_project_service.pubsub"
        ],
        "member": "serviceAccount:service-${data.google_project.current.number}@gcp-sa-pubsub.iam.gserviceaccount.com",
        "role": "roles/pubsub.subscriber",
        "subscription": "${google_pubsub_subscription.events.name}"
      }
    }
  },
  "output": {
    "web_ip_address": {
      "description": "The IP address of load balancer web; point your domains at it with an A record",
      "value": "${google_compute_global_address.web.address}"
    },
    "web_url": {
      "description": "Where load balancer web serves",
      "value": "http://${google_compute_global_address.web.address}"
    },
    "uploads_bucket": {
      "description": "The name of bucket uploads",
      "value": "${google_storage_bucket.uploads.name}"
    },
    "tmp_bucket": {
      "description": "The name of bucket tmp",
      "value": "${google_storage_bucket.tmp.name}"
    }
  }
}
