use aws in eu-west-2

service api
  image a

database db is postgres
bucket files
queue jobs

load balancer web
  listen on 80
  send / to api

on aws
  service api sets capacity_provider to FARGATE_SPOT
  service api sets enable_execute_command to true
  database db sets backup_retention_period to 14
  database db sets Deletion_Protection to true
  database db sets multi_azz to true
  bucket files sets versioning to true
  queue jobs sets visibility_timeout_seconds to 120
  load balancer web sets idle_timeout to 300
  load balancer web sets subnets to x
