{
  "//": "Generated by clowd from network.clowd. Edit that file instead: this one is rewritten on every build.",
  "terraform": {
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "= 6.14.1"
      }
    }
  },
  "provider": {
    "aws": {
      "default_tags": {
        "tags": {
          "clowd:project": "shop"
        }
      },
      "region": "eu-west-2"
    }
  },
  "data": {
    "aws_availability_zones": {
      "available": {
        "state": "available"
      }
    },
    "aws_region": {
      "current": {}
    }
  },
  "resource": {
    "aws_vpc": {
      "main": {
        "cidr_block": "10.20.0.0/16",
        "enable_dns_hostnames": true,
        "enable_dns_support": true,
        "tags": {
          "Name": "shop"
        }
      }
    },
    "aws_internet_gateway": {
      "main": {
        "tags": {
          "Name": "shop"
        },
        "vpc_id": "${aws_vpc.main.id}"
      }
    },
    "aws_subnet": {
      "public": {
        "availability_zone": "${data.aws_availability_zones.available.names[count.index]}",
        "cidr_block": "${cidrsubnet(aws_vpc.main.cidr_block, 8, count.index + 0)}",
        "count": 2,
        "tags": {
          "Name": "shop-public"
        },
        "vpc_id": "${aws_vpc.main.id}"
      },
      "private": {
        "availability_zone": "${data.aws_availability_zones.available.names[count.index]}",
        "cidr_block": "${cidrsubnet(aws_vpc.main.cidr_block, 8, count.index + 10)}",
        "count": 2,
        "tags": {
          "Name": "shop-private"
        },
        "vpc_id": "${aws_vpc.main.id}"
      }
    },
    "aws_route_table": {
      "public": {
        "tags": {
          "Name": "shop-public"
        },
        "vpc_id": "${aws_vpc.main.id}"
      },
      "private": {
        "tags": {
          "Name": "shop-private"
        },
        "vpc_id": "${aws_vpc.main.id}"
      }
    },
    "aws_route_table_association": {
      "public": {
        "count": 2,
        "route_table_id": "${aws_route_table.public.id}",
        "subnet_id": "${aws_subnet.public[count.index].id}"
      },
      "private": {
        "count": 2,
        "route_table_id": "${aws_route_table.private.id}",
        "subnet_id": "${aws_subnet.private[count.index].id}"
      }
    },
    "aws_route": {
      "public_internet": {
        "destination_cidr_block": "0.0.0.0/0",
        "gateway_id": "${aws_internet_gateway.main.id}",
        "route_table_id": "${aws_route_table.public.id}"
      }
    },
    "aws_ecs_cluster": {
      "main": {
        "name": "shop"
      }
    },
    "aws_cloudwatch_log_group": {
      "api": {
        "name": "/clowd/shop/api",
        "retention_in_days": 30
      }
    },
    "aws_iam_role": {
      "api_execution": {
        "assume_role_policy": "{\"Statement\":[{\"Action\":\"sts:AssumeRole\",\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"ecs-tasks.amazonaws.com\"}}],\"Version\":\"2012-10-17\"}",
        "name": "shop-api-execution"
      },
      "api_task": {
        "assume_role_policy": "{\"Statement\":[{\"Action\":\"sts:AssumeRole\",\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"ecs-tasks.amazonaws.com\"}}],\"Version\":\"2012-10-17\"}",
        "name": "shop-api-task"
      }
    },
    "aws_iam_role_policy_attachment": {
      "api_execution": {
        "policy_arn": "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy",
        "role": "${aws_iam_role.api_execution.name}"
      }
    },
    "aws_iam_role_policy": {
      "api_execution": {
        "name": "secrets",
        "policy": "{\"Statement\":[{\"Action\":[\"secretsmanager:GetSecretValue\"],\"Effect\":\"Allow\",\"Resource\":[\"${aws_db_instance.db.master_user_secret[0].secret_arn}\"]}],\"Version\":\"2012-10-17\"}",
        "role": "${aws_iam_role.api_execution.id}"
      }
    },
    "aws_security_group": {
      "api": {
        "description": "clowd service api",
        "name": "shop-api",
        "tags": {
          "Name": "shop-api"
        },
        "vpc_id": "${aws_vpc.main.id}"
      },
      "db": {
        "description": "clowd database db",
        "name": "shop-db",
        "tags": {
          "Name": "shop-db"
        },
        "vpc_id": "${aws_vpc.main.id}"
      },
      "web": {
        "description": "clowd load balancer web",
        "name": "shop-web",
        "tags": {
          "Name": "shop-web"
        },
        "vpc_id": "${aws_vpc.main.id}"
      }
    },
    "aws_vpc_security_group_egress_rule": {
      "api_all": {
        "cidr_ipv4": "0.0.0.0/0",
        "description": "pull images and reach dependencies",
        "ip_protocol": "-1",
        "security_group_id": "${aws_security_group.api.id}"
      },
      "web_to_api": {
        "description": "to service api",
        "from_port": 8080,
        "ip_protocol": "tcp",
        "referenced_security_group_id": "${aws_security_group.api.id}",
        "security_group_id": "${aws_security_group.web.id}",
        "to_port": 8080
      }
    },
    "aws_ecs_task_definition": {
      "api": {
        "container_definitions": "[{\"environment\":[{\"name\":\"DB_HOST\",\"value\":\"${aws_db_instance.db.address}\"},{\"name\":\"DB_PORT\",\"value\":\"5432\"},{\"name\":\"DB_NAME\",\"value\":\"db\"},{\"name\":\"DB_USER\",\"value\":\"clowd\"}],\"essential\":true,\"image\":\"a\",\"logConfiguration\":{\"logDriver\":\"awslogs\",\"options\":{\"awslogs-group\":\"${aws_cloudwatch_log_group.api.name}\",\"awslogs-region\":\"${data.aws_region.current.region}\",\"awslogs-stream-prefix\":\"api\"}},\"name\":\"api\",\"portMappings\":[{\"containerPort\":8080,\"protocol\":\"tcp\"}],\"secrets\":[{\"name\":\"DB_PASSWORD\",\"valueFrom\":\"${aws_db_instance.db.master_user_secret[0].secret_arn}:password::\"}]}]",
        "cpu": "256",
        "execution_role_arn": "${aws_iam_role.api_execution.arn}",
        "family": "shop-api",
        "memory": "512",
        "network_mode": "awsvpc",
        "requires_compatibilities": [
          "FARGATE"
        ],
        "runtime_platform": {
          "cpu_architecture": "X86_64",
          "operating_system_family": "LINUX"
        },
        "task_role_arn": "${aws_iam_role.api_task.arn}"
      }
    },
    "aws_vpc_security_group_ingress_rule": {
      "api_from_web": {
        "description": "from load balancer web",
        "from_port": 8080,
        "ip_protocol": "tcp",
        "referenced_security_group_id": "${aws_security_group.web.id}",
        "security_group_id": "${aws_security_group.api.id}",
        "to_port": 8080
      },
      "db_from_api": {
        "description": "from service api",
        "from_port": 5432,
        "ip_protocol": "tcp",
        "referenced_security_group_id": "${aws_security_group.api.id}",
        "security_group_id": "${aws_security_group.db.id}",
        "to_port": 5432
      },
      "web_80": {
        "cidr_ipv4": "0.0.0.0/0",
        "description": "listen on 80",
        "from_port": 80,
        "ip_protocol": "tcp",
        "security_group_id": "${aws_security_group.web.id}",
        "to_port": 80
      }
    },
    "aws_ecs_service": {
      "api": {
        "cluster": "${aws_ecs_cluster.main.id}",
        "depends_on": [
          "aws_iam_role_policy_attachment.api_execution",
          "aws_iam_role_policy.api_execution",
          "aws_lb_listener.web_80"
        ],
        "deployment_circuit_breaker": {
          "enable": true,
          "rollback": true
        },
        "desired_count": 1,
        "health_check_grace_period_seconds": 60,
        "launch_type": "FARGATE",
        "load_balancer": [
          {
            "container_name": "api",
            "container_port": 8080,
            "target_group_arn": "${aws_lb_target_group.web_api.arn}"
          }
        ],
        "name": "api",
        "network_configuration": {
          "assign_public_ip": true,
          "security_groups": [
            "${aws_security_group.api.id}"
          ],
          "subnets": "${aws_subnet.public[*].id}"
        },
        "propagate_tags": "SERVICE",
        "task_definition": "${aws_ecs_task_definition.api.arn}"
      }
    },
    "aws_db_subnet_group": {
      "db": {
        "name": "shop-db",
        "subnet_ids": "${aws_subnet.private[*].id}"
      }
    },
    "aws_db_instance": {
      "db": {
        "allocated_storage": 20,
        "copy_tags_to_snapshot": true,
        "db_name": "db",
        "db_subnet_group_name": "${aws_db_subnet_group.db.name}",
        "engine": "postgres",
        "identifier": "shop-db",
        "instance_class": "db.t4g.micro",
        "manage_master_user_password": true,
        "max_allocated_storage": 100,
        "publicly_accessible": false,
        "skip_final_snapshot": true,
        "storage_encrypted": true,
        "storage_type": "gp3",
        "username": "clowd",
        "vpc_security_group_ids": [
          "${aws_security_group.db.id}"
        ]
      }
    },
    "aws_lb": {
      "web": {
        "drop_invalid_header_fields": true,
        "internal": false,
        "load_balancer_type": "application",
        "name": "shop-web",
        "security_groups": [
          "${aws_security_group.web.id}"
        ],
        "subnets": "${aws_subnet.public[*].id}"
      }
    },
    "aws_lb_target_group": {
      "web_api": {
        "deregistration_delay": 30,
        "health_check": {
          "healthy_threshold": 2,
          "interval": 15,
          "matcher": "200-499",
          "path": "/",
          "unhealthy_threshold": 3
        },
        "name": "shop-web-api",
        "port": 8080,
        "protocol": "HTTP",
        "target_type": "ip",
        "vpc_id": "${aws_vpc.main.id}"
      }
    },
    "aws_lb_listener": {
      "web_80": {
        "default_action": {
          "target_group_arn": "${aws_lb_target_group.web_api.arn}",
          "type": "forward"
        },
        "load_balancer_arn": "${aws_lb.web.arn}",
        "port": 80,
        "protocol": "HTTP"
      }
    }
  },
  "output": {
    "web_dns_name": {
      "description": "The DNS name of load balancer web; point your domains at it with a CNAME record",
      "value": "${aws_lb.web.dns_name}"
    },
    "web_url": {
      "description": "Where load balancer web serves",
      "value": "http://${aws_lb.web.dns_name}"
    }
  }
}
