      }
    },
    "aws_db_instance": {
      "db": {
        "allocated_storage": 20,
        "copy_tags_to_snapshot": true,
        "db_name": "db",
        "db_subnet_group_name": "${aws_db_subnet_group.db.name}",
        "engine": "postgres",
        "engine_version": "16",
        "identifier": "shop-db",
        "instance_class": "db.t4g.medium",
        "manage_master_user_password": true,
        "max_allocated_storage": 100,
        "publicly_accessible": false,
        "skip_final_snapshot": true,
        "storage_encrypted": true,
        "storage_type": "gp3",
        "username": "clowd",
        "vpc_security_group_ids": [
          "${aws_security_group.db.id}"
        ]
      },
      "legacy-db": {
        "allocated_storage": 20,
        "copy_tags_to_snapshot": true,
        "db_name": "legacy_db",
        "db_subnet_group_name": "${aws_db_subnet_group.legacy-db.name}",
        "engine": "mysql",
        "engine_version": "8.0",
        "identifier": "shop-legacy-db",
        "instance_class": "db.m7g.large",
        "manage_master_user_password": true,
        "max_allocated_storage": 100,
        "publicly_accessible": false,
        "skip_final_snapshot": true,
        "storage_encrypted": true,
        "storage_type": "gp3",
        "username": "clowd",
        "vpc_security_group_ids": [
          "${aws_security_group.legacy-db.id}"
        ]
      }
    },
    "aws_s3_bucket": {
      "uploads": {
        "bucket_prefix": "shop-uploads-",
        "force_destroy": true
      },
      "assets": {
        "bucket_prefix": "shop-assets-",
        "force_destroy": true
      }
    },
    "aws_s3_bucket_public_access_block": {
      "uploads": {
        "block_public_acls": true,
        "block_public_policy": true,
        "bucket": "${aws_s3_bucket.uploads.id}",
        "ignore_public_acls": true,
        "restrict_public_buckets": true
      },
      "assets": {
        "block_public_acls": true,
        "block_public_policy": false,
        "bucket": "${aws_s3_bucket.assets.id}",
        "ignore_public_acls": true,
        "restrict_public_buckets": false
      }
    },
    "aws_s3_bucket_policy": {
      "assets": {
        "bucket": "${aws_s3_bucket.assets.id}",
        "depends_on": [
          "aws_s3_bucket_public_access_block.assets"
        ],
        "policy": "{\"Statement\":[{\"Action\":\"s3:GetObject\",\"Effect\":\"Allow\",\"Principal\":\"*\",\"Resource\":\"${aws_s3_bucket.assets.arn}/*\",\"Sid\":\"PublicRead\"}],\"Version\":\"2012-10-17\"}"
      }
    },
    "aws_sqs_queue": {
      "jobs": {
        "name": "shop-jobs"
      },
      "orders": {
        "content_based_deduplication": true,
        "fifo_queue": true,
        "name": "shop-orders.fifo"
      }
    },
    "aws_lb": {
      "web": {
        "drop_invalid_header_fields": true,
        "internal": false,
        "load_balancer_type": "application",
        "name": "shop-web",
        "security_groups": [
          "${aws_security_group.web.id}"
        ],
        "subnets": "${aws_subnet.public[*].id}"
      },
      "internal_lb": {
        "drop_invalid_header_fields": true,
        "internal": true,
        "load_balancer_type": "application",
        "name": "shop-internal-lb",
        "security_groups": [
          "${aws_security_group.internal_lb.id}"
        ],
        "subnets": "${aws_subnet.private[*].id}"
      }
    },
    "aws_lb_target_group": {
      "web_api": {
        "deregistration_delay": 30,
        "health_check": {
          "healthy_threshold": 2,
          "interval": 15,
          "matcher": "200-499",
          "path": "/",
          "unhealthy_threshold": 3
        },
        "name": "shop-web-api",
        "port": 3000,
        "protocol": "HTTP",
        "target_type": "ip",
        "vpc_id": "${aws_vpc.main.id}"
      },
      "web_admin": {
        "deregistration_delay": 30,
        "health_check": {
          "healthy_threshold": 2,
          "interval": 15,
          "matcher": "200-499",
          "path": "/",
          "unhealthy_threshold": 3
        },
        "name": "shop-web-admin",
        "port": 8080,
        "protocol": "HTTP",
        "target_type": "ip",
        "vpc_id": "${aws_vpc.main.id}"
      },
      "internal_lb_worker": {
        "deregistration_delay": 30,
        "health_check": {
          "healthy_threshold": 2,
          "interval": 15,
          "matcher": "200-499",
          "path": "/",
          "unhealthy_threshold": 3
        },
        "name": "shop-internal-lb-worker",
        "port": 8080,
        "protocol": "HTTP",
        "target_type": "ip",
        "vpc_id": "${aws_vpc.main.id}"
      }
    },
    "aws_acm_certificate": {
      "web_api_example_com": {
        "domain_name": "api.example.com",
        "lifecycle": {
          "create_before_destroy": true
        },
        "validation_method": "DNS"
      }
    },
    "aws_acm_certificate_validation": {
      "web_api_example_com": {
        "certificate_arn": "${aws_acm_certificate.web_api_example_com.arn}"
      }
    },
    "aws_lb_listener": {
      "web_443": {
        "certificate_arn": "${aws_acm_certificate_validation.web_api_example_com.certificate_arn}",
        "default_action": {
          "target_group_arn": "${aws_lb_target_group.web_api.arn}",
          "type": "forward"
        },
        "load_balancer_arn": "${aws_lb.web.arn}",
        "port": 443,
        "protocol": "HTTPS",
        "ssl_policy": "ELBSecurityPolicy-TLS13-1-2-2021-06"
      },
      "web_80": {
        "default_action": {
          "target_group_arn": "${aws_lb_target_group.web_api.arn}",
          "type": "forward"
        },
        "load_balancer_arn": "${aws_lb.web.arn}",
        "port": 80,
        "protocol": "HTTP"
      },
      "internal_lb_8080": {
        "default_action": {
          "fixed_response": {
            "content_type": "text/plain",
            "message_body": "not found",
            "status_code": "404"
          },
          "type": "fixed-response"
        },
        "load_balancer_arn": "${aws_lb.internal_lb.arn}",
        "port": 8080,
        "protocol": "HTTP"
      }
    },
    "aws_lb_listener_rule": {
      "web_443_1": {
        "action": {
          "target_group_arn": "${aws_lb_target_group.web_api.arn}",
          "type": "forward"
        },
        "condition": {
          "path_pattern": {
            "values": [
              "/admin/api*"
            ]
          }
        },
        "listener_arn": "${aws_lb_listener.web_443.arn}",
        "priority": 1
      },
      "web_443_2": {
        "action": {
          "target_group_arn": "${aws_lb_target_group.web_admin.arn}",
          "type": "forward"
        },
        "condition": {
          "path_pattern": {
            "values": [
              "/admin*"
            ]
          }
        },
        "listener_arn": "${aws_lb_listener.web_443.arn}",
        "priority": 2
      },
      "web_80_1": {
        "action": {
          "target_group_arn": "${aws_lb_target_group.web_api.arn}",
          "type": "forward"
        },
        "condition": {
          "path_pattern": {
            "values": [
              "/admin/api*"
            ]
          }
        },
        "listener_arn": "${aws_lb_listener.web_80.arn}",
        "priority": 1
      },
      "web_80_2": {
        "action": {
          "target_group_arn": "${aws_lb_target_group.web_admin.arn}",
          "type": "forward"
        },
        "condition": {
          "path_pattern": {
            "values": [
              "/admin*"
            ]
          }
        },
        "listener_arn": "${aws_lb_listener.web_80.arn}",
        "priority": 2
      },
      "internal_lb_8080_1": {
        "action": {
          "target_group_arn": "${aws_lb_target_group.internal_lb_worker.arn}",
          "type": "forward"
        },
        "condition": {
          "path_pattern": {
            "values": [
              "/status*"
            ]
          }
        },
        "listener_arn": "${aws_lb_listener.internal_lb_8080.arn}",
        "priority": 1
      }
    }
  },
  "output": {
    "uploads_bucket": {
      "description": "The name of bucket uploads",
      "value": "${aws_s3_bucket.uploads.bucket}"
    },
    "assets_bucket": {
      "description": "The name of bucket assets",
      "value": "${aws_s3_bucket.assets.bucket}"
    },
    "web_api_example_com_validation": {
      "description": "The DNS record that proves you own api.example.com",
      "value": "${aws_acm_certificate.web_api_example_com.domain_validation_options}"
    },
    "web_dns_name": {
      "description": "The DNS name of load balancer web; point your domains at it with a CNAME record",
      "value": "${aws_lb.web.dns_name}"
    },
    "web_url": {
      "description": "Where load balancer web serves",
      "value": "https://api.example.com"
    },
    "internal_lb_dns_name": {
      "description": "The DNS name of load balancer internal_lb; point your domains at it with a CNAME record",
      "value": "${aws_lb.internal_lb.dns_name}"
    },
    "internal_lb_url": {
      "description": "Where load balancer internal_lb serves",
      "value": "http://${aws_lb.internal_lb.dns_name}:8080"
    }
  }
}
