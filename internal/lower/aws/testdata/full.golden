        "deployment_circuit_breaker": {
          "enable": true,
          "rollback": true
        },
        "desired_count": 2,
        "health_check_grace_period_seconds": 60,
        "launch_type": "FARGATE",
        "lifecycle": {
          "ignore_changes": [
            "desired_count"
