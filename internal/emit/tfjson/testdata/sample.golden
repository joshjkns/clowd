{
  "//": "Generated by clowd from app.clowd. Do not edit.",
  "terraform": {
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 6.0"
      }
    }
  },
  "provider": {
    "aws": {
      "region": "eu-west-2"
    }
  },
  "data": {
    "aws_availability_zones": {
      "available": {
        "state": "available"
      }
    }
  },
  "ephemeral": {
    "random_password": {
      "db": {
        "length": 32
      }
    }
  },
  "resource": {
    "aws_vpc": {
      "main": {
        "cidr_block": "10.0.0.0/16",
        "enable_dns_hostnames": true
      },
      "other": {
        "cidr_block": "10.1.0.0/16"
      }
    },
    "aws_subnet": {
      "public": {
        "availability_zone": "${data.aws_availability_zones.available.names[count.index]}",
        "count": 2,
        "tags": {
          "Name": "shop-public"
        },
        "vpc_id": "${aws_vpc.main.id}"
      }
    },
    "aws_ecs_service": {
      "api": {
        "depends_on": [
          "aws_lb_listener.web"
        ],
        "load_balancer": [
          {
            "container_port": 8080
          },
          {
            "container_port": 9090
          }
        ],
        "network_configuration": {
          "subnets": "${aws_subnet.public[*].id}"
        },
        "note": "costs $${5} & <more> %%{if}"
      }
    }
  },
  "output": {
    "web_url": {
      "description": "Where web is served",
      "value": "http://${aws_lb.web.dns_name}"
    }
  }
}
