use 3:1-3:21
  cloud "aws" 3:5-3:8
  region "eu-west-2" 3:12-3:21
use 4:1-4:24
  cloud "gcp" 4:5-4:8
  region "europe-west2" 4:12-4:24
declare 6:1-6:34 database
  kind 6:1-6:9
  name "db" 6:10-6:12
  trait 6:16-6:27
    word "postgres" 6:16-6:24
    word "16" 6:25-6:27
  trait 6:29-6:34
    word "small" 6:29-6:34
  property 7:3-7:9
    key "on" 7:3-7:5
    value "aws" 7:6-7:9
    property 8:5-8:31
      key "backup_retention_period" 8:5-8:28
      value "14" 8:29-8:31
declare 10:1-10:26 bucket
  kind 10:1-10:7
  name "uploads" 10:8-10:15
  trait 10:19-10:26
    word "private" 10:19-10:26
declare 12:1-12:12 service
  kind 12:1-12:8
  name "api" 12:9-12:12
  property 13:3-13:30
    key "image" 13:3-13:8
    value "ghcr.io/me/api:latest" 13:9-13:30
  property 14:3-14:12
    key "port" 14:3-14:7
    value "8080" 14:8-14:12
  property 15:3-15:16
    key "scale" 15:3-15:8
    value "2" 15:9-15:10
    value "to" 15:11-15:13
    value "10" 15:14-15:16
declare 17:1-17:28 load balancer
  kind 17:1-17:14
  name "web" 17:15-17:18
  trait 17:22-17:28
    word "public" 17:22-17:28
  property 18:3-18:45
    key "listen" 18:3-18:9
    value "on" 18:10-18:12
    value "443" 18:13-18:16
    value "with" 18:17-18:21
    value "tls" 18:22-18:25
    value "for" 18:26-18:29
    value "api.example.com" 18:30-18:45
  property 19:3-19:16
    key "send" 19:3-19:7
    value "/" 19:8-19:9
    value "to" 19:10-19:12
    value "api" 19:13-19:16
relate 21:1-21:19
  from "api" 21:1-21:4
  verb "connects to" 21:5-21:16
  to "db" 21:17-21:19
relate 22:1-22:29
  from "api" 22:1-22:4
  verb "reads and writes" 22:5-22:21
  to "uploads" 22:22-22:29
