use 3:1-3:21
  cloud "aws" 3:5-3:8
  region "eu-west-2" 3:12-3:21
use 4:1-4:24
  cloud "gcp" 4:5-4:8
  region "europe-west2" 4:12-4:24
declare 6:1-6:34 database
  kind 6:1-6:9
  name "db" 6:10-6:12
  trait 6:16-6:27
    word "postgres" 6:16-6:24
    word "16" 6:25-6:27
  trait 6:29-6:34
    word "small" 6:29-6:34
declare 7:1-7:26 bucket
  kind 7:1-7:7
  name "uploads" 7:8-7:15
  trait 7:19-7:26
    word "private" 7:19-7:26
declare 9:1-9:12 service
  kind 9:1-9:8
  name "api" 9:9-9:12
  property 10:3-10:30
    key "image" 10:3-10:8
    value "ghcr.io/me/api:latest" 10:9-10:30
  property 11:3-11:12
    key "port" 11:3-11:7
    value "8080" 11:8-11:12
  property 12:3-12:16
    key "scale" 12:3-12:8
    value "2" 12:9-12:10
    value "to" 12:11-12:13
    value "10" 12:14-12:16
declare 14:1-14:28 load balancer
  kind 14:1-14:14
  name "web" 14:15-14:18
  trait 14:22-14:28
    word "public" 14:22-14:28
  property 15:3-15:45
    key "listen" 15:3-15:9
    value "on" 15:10-15:12
    value "443" 15:13-15:16
    value "with" 15:17-15:21
    value "tls" 15:22-15:25
    value "for" 15:26-15:29
    value "api.example.com" 15:30-15:45
  property 16:3-16:16
    key "send" 16:3-16:7
    value "/" 16:8-16:9
    value "to" 16:10-16:12
    value "api" 16:13-16:16
relate 18:1-18:19
  from "api" 18:1-18:4
  verb "connects to" 18:5-18:16
  to "db" 18:17-18:19
relate 19:1-19:29
  from "api" 19:1-19:4
  verb "reads and writes" 19:5-19:21
  to "uploads" 19:22-19:29
on 21:1-21:7
  cloud "aws" 21:4-21:7
  override 22:3-22:49 database
    name "db" 22:12-22:14
    key "backup_retention_period" 22:20-22:43
    value "14" 22:47-22:49
