use 2:1-2:21
  cloud "aws" 2:5-2:8
  region "eu-west-2" 2:12-2:21
use 3:1-3:8
  cloud "gcp" 3:5-3:8
use 4:1-4:27
  cloud "Azure" 4:5-4:10
  region string "west europe" 4:14-4:27
declare 6:1-6:34 database
  kind 6:1-6:9
  name "db" 6:10-6:12
  trait 6:16-6:27
    word "postgres" 6:16-6:24
    word "16" 6:25-6:27
  trait 6:29-6:34
    word "small" 6:29-6:34
declare 7:1-7:49 database
  kind 7:1-7:9
  name "cache" 7:10-7:15
  trait 7:19-7:26
    word "redis" 7:19-7:24
    word "7" 7:25-7:26
  trait 7:31-7:36
    word "small" 7:31-7:36
  trait 7:41-7:49
    word "internal" 7:41-7:49
declare 8:1-8:26 bucket
  kind 8:1-8:7
  name "uploads" 8:8-8:15
  trait 8:19-8:26
    word "private" 8:19-8:26
declare 9:1-9:19 queue
  kind 9:1-9:6
  name "jobs" 9:7-9:11
  trait 9:15-9:19
    word "fifo" 9:15-9:19
declare 10:1-10:8 load balancer
  kind 10:1-10:3
  name "edge" 10:4-10:8
declare 11:1-11:28 load balancer
  kind 11:1-11:14
  name "web" 11:15-11:18
  trait 11:22-11:28
    word "public" 11:22-11:28
  property 12:3-12:45
    key "listen" 12:3-12:9
    value "on" 12:10-12:12
    value "443" 12:13-12:16
    value "with" 12:17-12:21
    value "tls" 12:22-12:25
    value "for" 12:26-12:29
    value "api.example.com" 12:30-12:45
  property 13:3-13:16
    key "send" 13:3-13:7
    value "/" 13:8-13:9
    value "to" 13:10-13:12
    value "api" 13:13-13:16
declare 15:1-15:12 service
  kind 15:1-15:8
  name "api" 15:9-15:12
  property 16:3-16:30
    key "image" 16:3-16:8
    value "ghcr.io/me/api:latest" 16:9-16:30
  property 17:3-17:12
    key "port" 17:3-17:7
    value "8080" 17:8-17:12
  property 18:3-18:16
    key "scale" 18:3-18:8
    value "2" 18:9-18:10
    value "to" 18:11-18:13
    value "10" 18:14-18:16
  property 19:3-19:30
    key "env" 19:3-19:6
    value "GREETING" 19:7-19:15
    value string "hello, world" 19:16-19:30
  property 20:3-20:14
    key "healthcheck" 20:3-20:14
relate 22:1-22:19
  from "api" 22:1-22:4
  verb "connects to" 22:5-22:16
  to "db" 22:17-22:19
relate 23:1-23:29
  from "api" 23:1-23:4
  verb "reads and writes" 23:5-23:21
  to "uploads" 23:22-23:29
relate 24:1-24:18
  from "api" 24:1-24:4
  verb "reads" 24:5-24:10
  to "uploads" 24:11-24:18
relate 25:1-25:19
  from "api" 25:1-25:4
  verb "writes" 25:5-25:11
  to "uploads" 25:12-25:19
relate 26:1-26:18
  from "api" 26:1-26:4
  verb "sends to" 26:5-26:13
  to "jobs" 26:14-26:18
relate 27:1-27:19
  from "API" 27:1-27:4
  verb "connects to" 27:5-27:16
  to "DB" 27:17-27:19
relate 28:1-28:21
  from "queue" 28:1-28:6
  verb "connects to" 28:7-28:18
  to "db" 28:19-28:21
relate 29:1-29:17
  from "on" 29:1-29:3
  verb "reads" 29:4-29:9
  to "uploads" 29:10-29:17
on 31:1-31:7
  cloud "aws" 31:4-31:7
  override 32:3-32:53 service
    name "api" 32:11-32:14
    key "capacity_provider" 32:20-32:37
    value "FARGATE_SPOT" 32:41-32:53
  override 33:3-33:45 load balancer
    name "web" 33:17-33:20
    key "idle_timeout" 33:26-33:38
    value "120" 33:42-33:45
  override 34:3-34:44 database
    name "db" 34:12-34:14
    key "tags" 34:20-34:24
    value string "team: payments" 34:28-34:44
