use aws in eu-west-2
use gcp
use azure in westeurope
use AWS in us-east-1
use amazon in us-east-1
use gpc in europe-west2
use digitalocean

service api
  image a
database db is postgres

on aws
  service api sets capacity_provider to FARGATE_SPOT
  database db sets multi_az to true
  service api sets capacity_provider to FARGATE

on gcp
  service api sets max_instance_request_concurrency to 80

on oracle
  service api sets x to y
