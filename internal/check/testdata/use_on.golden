target aws eu-west-2 1:1
target gcp <default> 2:1
target azure westeurope 3:1
service api 9:9
  image "a"
  port 8080
  scale 1 to 1
  at image 10:3
  at port 11:3
database db 37:10
  engine postgres <default>
  size small
  at engine 37:16
override aws service api 13:3
  platform_version = "LATEST" 14:5
  capacity_provider_strategy 16:5
    capacity_provider = "FARGATE_SPOT" 17:7
    weight = "1" 18:7
  capacity_provider_strategy 19:5
    capacity_provider = "FARGATE" 20:7
    base = "1" 21:7
  tags_all = ["a" "b c"] 22:5
override gcp service api 28:3
  max_instance_request_concurrency = "80" 29:5
override aws database db 38:3
  multi_az = "true" 39:5

