target aws eu-west-2 1:1
target gcp <default> 2:1
target azure westeurope 3:1
service api 9:9
  image "a"
  port 8080
  scale 1 to 1
  at image 10:3
database db 11:10
  engine postgres <default>
  size small
  at engine 11:16
override aws service api capacity_provider = "FARGATE_SPOT" 14:3
override aws database db multi_az = "true" 15:3
override gcp service api max_instance_request_concurrency = "80" 19:3

