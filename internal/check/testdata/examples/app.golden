target aws eu-west-2 3:1
target gcp europe-west2 4:1
database db 6:10
  engine postgres 16
  size small
  at engine 6:16
  at size 6:29
bucket uploads 10:8
  public false
  at visibility 10:19
service api 12:9
  image "ghcr.io/me/api:latest"
  port 8080
  scale 2 to 10
  at image 13:3
  at port 14:3
  at scale 15:3
load balancer web 17:15
  internal false
  listen 443 tls api.example.com
  route / -> api
  at listen 18:3
  at send 19:3
  at visibility 17:22
relation api connects to db 21:1
relation api reads and writes uploads 22:1
override aws database db 7:3
  backup_retention_period = "14" 8:5
