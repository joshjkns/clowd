target aws eu-west-2 1:1
service api 3:9
  image "a"
  port 8080
  scale 1 to 1
  health check /healthz
  command ["./server" "--port" "8080"]
  at command 6:3
  at health 5:3
  at image 4:3
service w1 8:9
  image "b"
  port 8080
  scale 1 to 1
  health check /up
  at health 10:3
  at image 9:3
service w2 12:9
  image "b"
  port 8080
  scale 1 to 1
  at image 13:3
service w3 15:9
  image "b"
  port 8080
  scale 1 to 1
  at image 16:3
service w4 18:9
  image "b"
  port 8080
  scale 1 to 1
  at image 19:3
database db 22:10
  engine postgres 16
  size medium
  highly available
  protected
  storage 50gb
  backups 14 days
  at availability 22:37
  at backups 24:3
  at engine 22:16
  at protection 22:58
  at size 22:29
  at storage 23:3
database d1 26:10
  engine mysql 8.0
  size small
  highly available
  backups 0 days
  at availability 26:27
  at backups 28:3
  at engine 26:16
database d2 29:10
  engine postgres <default>
  size small
  highly available
  at availability 29:26
  at engine 29:16
database d3 32:10
  engine postgres <default>
  size small
  storage 30gb
  at engine 32:16
  at storage 35:3
bucket uploads 37:8
  public false
  versioned
  protected
  expire after 30 days
  at expire 38:3
  at protection 37:30
  at versioning 37:19
bucket b1 40:8
  public false
bucket b2 42:8
  public false
bucket b3 44:8
  public false
  expire after 1 days
  at expire 45:3
queue jobs 47:7
  fifo false
  retry 5 times
  timeout 60s
  keep messages for 345600s
  at keep 50:3
  at retry 48:3
  at timeout 49:3
queue q1 52:7
  fifo false
queue q2 56:7
  fifo false
  retry 3 times
  at retry 57:3

