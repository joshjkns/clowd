target aws eu-west-2 1:1
service api 3:9
  image "a"
  port 8080
  scale 1 to 1
  at image 4:3
service admin 5:9
  image "b"
  port 8080
  scale 1 to 1
  at image 6:3
database db 7:10
  engine postgres <default>
  size small
  at engine 7:16
load balancer web 9:15
  internal false
  listen 443 tls api.example.com
  listen 80
  route / -> api
  route /admin -> admin
  at listen 10:3
  at send 12:3
  at visibility 9:22
load balancer internal_lb 15:4
  internal true
  listen 8080
  route / -> api
  at listen 16:3
  at send 17:3
  at visibility 15:19
load balancer bad 19:15
  internal true
  listen 9000
  route /x -> api
  at listen 27:3
  at send 34:3
  at visibility 19:22
load balancer empty 37:15
  internal false
load balancer norules 39:15
  internal false
  listen 80
  at listen 40:3
load balancer synonym_route 42:15
  internal false
  listen 80
  at listen 43:3

