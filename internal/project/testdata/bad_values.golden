name "My App"
edition 2026
runtime ""
state.backend "s3"
aws.network.services "public"
aws.network.cidr "10.0.0.0/16"
aws.network.vpc "vpc-1"
aws.network.public_subnets ["subnet-a"]
aws.network.private_subnets []

