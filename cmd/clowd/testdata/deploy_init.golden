--- app.clowd
# Describe your infrastructure, then run `clowd check` and `clowd apply`.

use aws in eu-west-2

# The project's name prefixes everything deployed.
project app-001

# Uncomment to run services behind a NAT gateway instead of giving them
# public addresses, or to choose the network's address block:
# network is private
#   cidr 10.0.0.0/16

service app
  image nginx:latest
  port 80

load balancer web
  listen on 80
  send / to app

